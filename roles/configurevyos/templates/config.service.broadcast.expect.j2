#!/usr/bin/expect -f

set username {{ prop_admin_username }}
set password {{ prop_admin_password }}

set timeout 40

spawn qm terminal {{ prop_proxmox_vmid }}

expect "(press Ctrl+O to exit)"
send -- "\r"

expect "vyos login"
send -- "$username\r"

expect "Password:"
send -- "$password\r"

expect "Welcome to VyOS!"
expect "$username@*"
send -- "config\r"

{% if prop_vyos_broadcast is defined %}
    {% for broadcast in prop_vyos_broadcast %}
        expect "$username@*"
        send -- "set service  broadcast-relay {{ broadcast.id }} description {{ broadcast.description }}\r"
        {% for interface in broadcast.interfaces %}
            expect "$username@*"
            send -- "set service  broadcast-relay {{ broadcast.id }} interface {{ interface }}\r"
        {% endfor %}
        expect "$username@*"
        send -- "set service  broadcast-relay {{ broadcast.id }} port {{ broadcast.port }}\r"
    {% endfor %}
{% endif %}

expect "$username@*"
send -- "commit\r"

expect "$username@*"
send -- "save\r"

expect "$username@*"
send -- "exit\r"

expect "$username@*"
send -- "exit\r"

expect "logout"
send -- "\x0f"
expect eof

send_user "**** Changed Finished Expect: Network configured\n"

